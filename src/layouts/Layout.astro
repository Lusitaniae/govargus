---
import { indicators, seriesFor, formatDate } from '../lib/data';
import { abs, cleanPath } from '../lib/seo';
interface Props {
  title?: string;
  description?: string;
  /** Site path of the social preview image. */
  image?: string;
  /** JSON-LD object(s) for this page. */
  schema?: object | object[];
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Site path of this page's Markdown version, for AI agents. */
  markdown?: string;
}
const {
  title,
  description = 'How the United States is doing, measured: official indicators across presidencies, with the policies and shocks that shaped them.',
  image = '/og/site.png',
  schema,
  noindex = false,
  markdown,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = cleanPath(Astro.url.pathname.replace(base, ''));
// The brand only fits on short titles; the search phrase matters more.
const fullTitle = !title ? 'Govargus' : title.includes('Govargus') || `${title} · Govargus`.length > 60 ? title : `${title} · Govargus`;
const canonical = abs(path === '/' ? '/' : path);
const refreshed = indicators.map((i) => seriesFor(i.id).fetched).sort().at(-1)!;
const nav = [
  { href: '/', label: 'Indicators' },
  { href: '/presidents', label: 'Presidents' },
  { href: '/compare', label: 'Compare' },
  { href: '/events', label: 'Policy timeline' },
  { href: '/about', label: 'Method' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Govargus" />
    <meta property="og:title" content={title ?? 'How is the United States doing?'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    {markdown && <link rel="alternate" type="text/markdown" href={abs(markdown)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Gov<span>argus</span></a>
        <nav>
          {nav.map((n) => <a href={`${base}${n.href}`} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Data from US government sources (BLS, BEA, Census, FBI, CDC and others, several via{' '}
          <a href="https://fred.stlouisfed.org/">FRED</a>), refreshed weekly, last on <time datetime={refreshed}>{formatDate(refreshed)}</time>.
          Shaded bands are presidential terms; <span class="rec-key"></span> hatched areas are recessions (NBER);{' '}
          <span class="event-key"></span> markers are policy events and shocks.
        </p>
        <p><a href="https://github.com/Lusitaniae/govargus">Source &amp; data on GitHub</a></p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Crosshair + tooltip for every chart. Reads the precomputed pixel positions
  // the server wrote into data-chart, so no scales are recomputed here.
  import { formatPeriod, formatValue } from '../lib/format';
  type Data = {
    points: [string, number][]; xy: [number, number][]; terms: [string, string, string][];
    unit: string; decimals: number; frequency: string; plot: [number, number]; width: number; provisionalFrom: string | null;
  };

  for (const fig of document.querySelectorAll<HTMLElement>('figure[data-chart]')) {
    const data: Data = JSON.parse(fig.dataset.chart!);
    const svg = fig.querySelector('svg')!;
    const cross = fig.querySelector<SVGLineElement>('.crosshair')!;
    const dot = fig.querySelector<SVGCircleElement>('.dot')!;
    const tip = fig.querySelector<HTMLElement>('.tooltip')!;

    const show = (clientX: number) => {
      const rect = svg.getBoundingClientRect();
      const scale = rect.width / data.width;
      const px = (clientX - rect.left) / scale;
      if (px < data.plot[0] - 4 || px > data.plot[1] + 4 || !data.xy.length) return hide();
      let i = 0;
      for (let j = 1; j < data.xy.length; j++) if (Math.abs(data.xy[j][0] - px) < Math.abs(data.xy[i][0] - px)) i = j;
      const [cx, cy] = data.xy[i];
      const [date, value] = data.points[i];
      cross.setAttribute('x1', String(cx)); cross.setAttribute('x2', String(cx));
      dot.setAttribute('cx', String(cx)); dot.setAttribute('cy', String(cy));
      const who = data.terms.find(([s, e]) => s <= date && date < e)?.[2] ?? '';
      const prov = data.provisionalFrom && date >= data.provisionalFrom ? ' (provisional)' : '';
      tip.innerHTML = `<b>${formatValue(value, data)}</b>${prov}<br>${formatPeriod(date, data.frequency)}${who ? ` · <span>${who}</span>` : ''}`;
      fig.classList.add('active');
      const left = cx * scale, top = cy * scale;
      const w = tip.offsetWidth;
      tip.style.left = `${Math.min(Math.max(left - w / 2, 0), rect.width - w)}px`;
      tip.style.top = `${Math.max(top - tip.offsetHeight - 12, -8)}px`;
    };
    const hide = () => fig.classList.remove('active');
    svg.addEventListener('pointermove', (e) => show(e.clientX));
    svg.addEventListener('pointerdown', (e) => show(e.clientX));
    svg.addEventListener('pointerleave', hide);
  }
</script>

<style is:global>
  :root {
    color-scheme: light;
    --font: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --page: #f9f9f7;
    --surface: #fcfcfb;
    --surface-raised: #ffffff;
    --text-primary: #0b0b0b;
    --text-secondary: #52514e;
    --text-muted: #898781;
    --grid: #e1e0d9;
    --baseline: #c3c2b7;
    --border: rgba(11, 11, 11, 0.10);
    --series-1: #2a78d6;
    --event: #eb6834;
    --band: rgba(11, 11, 11, 0.045);
    --band-hl: rgba(42, 120, 214, 0.12);
    --recession: rgba(11, 11, 11, 0.03);
    --recession-ink: rgba(11, 11, 11, 0.13);
    --link: #256abf;
    --cat-1: #2a78d6;
    --cat-2: #eb6834;
    --cat-3: #1baf7a;
    --context-line: rgba(11, 11, 11, 0.16);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --page: #0d0d0d;
      --surface: #1a1a19;
      --surface-raised: #242423;
      --text-primary: #f0efec;
      --text-secondary: #c3c2b7;
      --text-muted: #898781;
      --grid: #2c2c2a;
      --baseline: #383835;
      --border: rgba(255, 255, 255, 0.10);
      --series-1: #3987e5;
      --event: #d95926;
      --band: rgba(255, 255, 255, 0.05);
      --band-hl: rgba(57, 135, 229, 0.20);
      --recession: rgba(255, 255, 255, 0.02);
      --recession-ink: rgba(255, 255, 255, 0.13);
      --link: #6da7ec;
      --cat-1: #3987e5;
      --cat-2: #d95926;
      --cat-3: #199e70;
      --context-line: rgba(255, 255, 255, 0.18);
    }
  }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --page: #0d0d0d;
    --surface: #1a1a19;
    --surface-raised: #242423;
    --text-primary: #f0efec;
    --text-secondary: #c3c2b7;
    --text-muted: #898781;
    --grid: #2c2c2a;
    --baseline: #383835;
    --border: rgba(255, 255, 255, 0.10);
    --series-1: #3987e5;
    --event: #d95926;
    --band: rgba(255, 255, 255, 0.05);
    --band-hl: rgba(57, 135, 229, 0.20);
    --recession: rgba(255, 255, 255, 0.02);
    --recession-ink: rgba(255, 255, 255, 0.13);
    --link: #6da7ec;
    --cat-1: #3987e5;
    --cat-2: #d95926;
    --cat-3: #199e70;
    --context-line: rgba(255, 255, 255, 0.18);
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--page); color: var(--text-primary); font: 16px/1.5 var(--font); }
  a { color: var(--link); }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  main.wrap { padding-top: 24px; padding-bottom: 48px; }
  h1 { font-size: 28px; line-height: 1.2; margin: 8px 0 8px; letter-spacing: -0.01em; }
  h2 { font-size: 20px; margin: 40px 0 12px; }
  h3 { font-size: 16px; margin: 0; }
  .lede { color: var(--text-secondary); max-width: 68ch; margin: 0 0 8px; }
  .muted { color: var(--text-muted); }
  .small { font-size: 13px; }

  header.site { background: var(--surface); border-bottom: 1px solid var(--border); }
  header.site .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; min-height: 56px; }
  .brand { font-weight: 700; font-size: 20px; color: var(--text-primary); text-decoration: none; }
  .brand span { color: var(--series-1); }
  header nav { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  header nav a { color: var(--text-secondary); text-decoration: none; font-size: 15px; padding: 4px 0; }
  header nav a[aria-current='page'] { color: var(--text-primary); box-shadow: inset 0 -2px var(--series-1); }

  footer.site { border-top: 1px solid var(--border); color: var(--text-secondary); font-size: 13px; padding: 16px 0 32px; }
  .rec-key, .event-key { display: inline-block; width: 12px; height: 12px; vertical-align: -1px; margin-right: 2px; }
  .rec-key { background: repeating-linear-gradient(45deg, var(--recession-ink) 0 1px, var(--recession) 1px 5px); border: 1px solid var(--border); }
  .event-key { background: var(--event); border-radius: 50%; }

  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 14px 10px; }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }

  table.data { width: 100%; border-collapse: collapse; font-size: 14px; }
  table.data th, table.data td { padding: 8px 10px; border-bottom: 1px solid var(--grid); text-align: right; vertical-align: top; }
  table.data th:first-child, table.data td:first-child { text-align: left; }
  table.data thead th { color: var(--text-secondary); font-weight: 600; font-size: 13px; border-bottom-color: var(--baseline); }
  table.data td { font-variant-numeric: tabular-nums; }
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  .tag { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--border); color: var(--text-secondary); white-space: nowrap; }
  .chart svg { touch-action: pan-y; }
</style>
