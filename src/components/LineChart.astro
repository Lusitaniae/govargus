---
// Server-rendered SVG line chart with presidential terms, recessions and policy
// events behind the line. Hover behaviour lives in Layout's script and reads
// the data-* attributes set here; without JS the chart still renders fully.
import {
  type Indicator, type Point, presidents, recessions, events, termEnd, today,
  formatValue, formatDate, KIND_LABEL,
} from '../lib/data';

interface Props {
  indicator: Indicator;
  points: Point[];
  from: string;
  to?: string;
  size?: 'card' | 'full';
  highlight?: string;
  /** Annual counts drawn as bars from zero instead of a line. */
  bars?: boolean;
  showRecessions?: boolean;
  /** Drawing width; raise it where the chart is laid out wider, so text stays the same size. */
  width?: number;
}

const { indicator: ind, points: allPoints, from, to = today(), size = 'full', highlight, bars = false, showRecessions = true, width } = Astro.props;

const W = width ?? (size === 'card' ? 340 : 860);
const H = size === 'card' ? 180 : 340;
const M = size === 'card'
  ? { top: 20, right: 8, bottom: 24, left: 44 }
  : { top: 24, right: 16, bottom: 34, left: 56 };
const FONT = size === 'card' ? 14 : 11;

const points = allPoints.filter(([d]) => d >= from && d <= to);
const t = (d: string) => Date.parse(d + 'T00:00:00Z');
const x0 = t(from), x1 = t(to);
const x = (d: string) => M.left + ((Math.min(Math.max(t(d), x0), x1) - x0) / (x1 - x0)) * (W - M.left - M.right);

// Y domain from the visible points, padded, snapped to "nice" ticks.
let lo = Math.min(...points.map((p) => p[1]));
let hi = Math.max(...points.map((p) => p[1]));
const pad = (hi - lo) * 0.08 || 1;
lo = bars ? Math.min(0, lo) : lo - pad;
hi += pad;
function niceStep(span: number, count: number) {
  const raw = span / count;
  const pow = 10 ** Math.floor(Math.log10(raw));
  const f = raw / pow;
  return (f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10) * pow;
}
const step = niceStep(hi - lo, size === 'card' ? 3 : 5);
lo = Math.floor(lo / step) * step;
hi = Math.ceil(hi / step) * step;
const yTicks: number[] = [];
for (let v = lo; v <= hi + step / 2; v += step) yTicks.push(+v.toFixed(10));
const y = (v: number) => M.top + (1 - (v - lo) / (hi - lo)) * (H - M.top - M.bottom);

const tickLabel = (v: number) => {
  const decimals = step < 1 ? 1 : 0;
  if (ind.unit === '$' && Math.abs(v) >= 1000) return `$${(v / 1000).toFixed(0)}k`;
  return formatValue(v, ind, { decimals }).replace(/ .*/, '');
};

// X ticks: every 5 years on the big chart, every 10 on cards (fewer for short ranges).
const yearFrom = Number(from.slice(0, 4)), yearTo = Number(to.slice(0, 4));
const span = yearTo - yearFrom;
const every = span <= 20 ? (size === 'card' ? 5 : 2) : size === 'card' ? 10 : 5;
const xTicks: string[] = [];
for (let yr = Math.ceil(yearFrom / every) * every; yr <= yearTo; yr += every) {
  const d = `${yr}-01-01`;
  if (d >= from) xTicks.push(d);
}

const path = bars ? '' : points.map(([d, v], i) => `${i ? 'L' : 'M'}${x(d).toFixed(1)},${y(v).toFixed(1)}`).join('');

// Bars span their year with a 2px gap, rounded only at the data end.
const nextYear = (d: string) => `${Number(d.slice(0, 4)) + 1}${d.slice(4)}`;
const barShapes = !bars ? [] : points.map(([d, v]) => {
  const bx0 = x(d) + 1, bx1 = x(nextYear(d)) - 1, top = y(v), base = y(0);
  const r = Math.max(0, Math.min(3, (bx1 - bx0) / 2, base - top));
  return {
    d: `M${bx0},${base}V${top + r}Q${bx0},${top} ${bx0 + r},${top}H${bx1 - r}Q${bx1},${top} ${bx1},${top + r}V${base}Z`,
    cx: (bx0 + bx1) / 2,
  };
});

const terms = presidents
  .map((p, i) => ({ ...p, i, x0: x(p.start), x1: x(termEnd(p)) }))
  .filter((p) => termEnd(p) > from && p.start < to);
const recs = (showRecessions ? recessions : [])
  .map((r) => ({ x0: x(r.start), x1: x(r.end ?? to) }))
  .filter((r) => r.x1 > r.x0);
const evts = events.filter((e) => e.indicators.includes(ind.id) && e.date >= from && e.date <= to);

const plotTop = M.top, plotBottom = H - M.bottom;
const zeroInside = lo < 0 && hi > 0;
const labelFits = (p: { x0: number; x1: number; short: string }) => p.x1 - p.x0 > p.short.length * FONT * 0.6 + 6;

const hoverData = JSON.stringify({
  points,
  xy: points.map(([d, v], i) => [+(bars ? barShapes[i].cx : x(d)).toFixed(1), +y(v).toFixed(1)]),
  terms: presidents.map((p) => [p.start, termEnd(p), p.name]),
  unit: ind.unit,
  decimals: ind.decimals,
  frequency: ind.frequency,
  plot: [M.left, W - M.right],
  width: W,
});
---
<figure class:list={['chart', `size-${size}`]} data-chart={hoverData}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${ind.name}, ${from.slice(0, 4)} to ${to.slice(0, 4)}`}>
    <defs>
      <pattern id={`rec-${ind.id}-${size}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" class="rec-bg" />
        <line x1="0" y1="0" x2="0" y2="6" class="rec-hatch" />
      </pattern>
    </defs>

    {terms.map((p) => (
      <g class:list={['term', { alt: p.i % 2 === 1, hl: highlight === p.slug, dim: highlight && highlight !== p.slug }]}>
        <rect x={p.x0} y={plotTop} width={p.x1 - p.x0} height={plotBottom - plotTop} />
        {labelFits(p) && (
          <text x={(p.x0 + p.x1) / 2} y={plotTop - 6} text-anchor="middle" class="term-label">{p.short}</text>
        )}
        <title>{p.name} ({p.party})</title>
      </g>
    ))}

    {recs.map((r) => (
      <rect class="rec" x={r.x0} y={plotTop} width={r.x1 - r.x0} height={plotBottom - plotTop}
        fill={`url(#rec-${ind.id}-${size})`}><title>Recession (NBER)</title></rect>
    ))}

    {yTicks.map((v) => (
      <g>
        <line class="grid" x1={M.left} x2={W - M.right} y1={y(v)} y2={y(v)} />
        <text class="tick" x={M.left - 6} y={y(v) + 4} text-anchor="end">{tickLabel(v)}</text>
      </g>
    ))}
    {zeroInside && <line class="zero" x1={M.left} x2={W - M.right} y1={y(0)} y2={y(0)} />}
    <line class="axis" x1={M.left} x2={W - M.right} y1={plotBottom} y2={plotBottom} />
    {xTicks.map((d) => (
      <text class="tick" x={x(d)} y={plotBottom + (size === 'card' ? 18 : 16)} text-anchor="middle">{d.slice(0, 4)}</text>
    ))}

    {bars ? barShapes.map((b) => <path class="bar" d={b.d} />) : <path class="line" d={path} />}

    {evts.map((e) => (
      <a href={e.link} target="_blank" rel="noopener" class="event">
        <line x1={x(e.date)} x2={x(e.date)} y1={plotTop} y2={plotBottom} />
        <circle cx={x(e.date)} cy={plotBottom} r={size === 'card' ? 4 : 5} />
        <title>{`${formatDate(e.date)} · ${KIND_LABEL[e.kind]}: ${e.title}`}</title>
      </a>
    ))}

    <g class="hover" aria-hidden="true">
      <line class="crosshair" y1={plotTop} y2={plotBottom} />
      <circle class="dot" r="4.5" />
    </g>
  </svg>
  <div class="tooltip" role="status" aria-live="polite"></div>
</figure>

<style>
  .chart { position: relative; margin: 0; }
  svg { display: block; width: 100%; height: auto; overflow: visible; font: 11px var(--font); font-variant-numeric: tabular-nums; }
  .size-card svg, .size-card .term-label { font-size: 14px; }
  .term rect { fill: transparent; }
  .term.alt rect { fill: var(--band); }
  .term.hl rect { fill: var(--band-hl); }
  .term.dim .term-label { opacity: 0.5; }
  .term-label { fill: var(--text-secondary); font-size: 11px; }
  .rec-bg { fill: var(--recession); }
  .rec-hatch { stroke: var(--recession-ink); stroke-width: 1; }
  .rec { pointer-events: all; }
  .grid { stroke: var(--grid); stroke-width: 1; }
  .zero { stroke: var(--baseline); stroke-width: 1.5; }
  .axis { stroke: var(--baseline); stroke-width: 1; }
  .tick { fill: var(--text-muted); }
  .line { fill: none; stroke: var(--series-1); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .bar { fill: var(--series-1); }
  .event line { stroke: var(--event); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.55; }
  .event circle { fill: var(--event); stroke: var(--surface); stroke-width: 2; }
  .event:hover line, .event:focus line { opacity: 1; }
  .event:hover circle, .event:focus circle { r: 6.5; }
  .hover { display: none; pointer-events: none; }
  .chart.active .hover { display: block; }
  .crosshair { stroke: var(--text-muted); stroke-width: 1; }
  .dot { fill: var(--series-1); stroke: var(--surface); stroke-width: 2; }
  .tooltip {
    position: absolute; top: 0; left: 0; display: none; pointer-events: none; z-index: 2;
    background: var(--surface-raised); color: var(--text-primary); border: 1px solid var(--border);
    border-radius: 6px; padding: 6px 8px; font-size: 12px; line-height: 1.35; white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }
  .tooltip :global(b) { font-size: 14px; }
  .tooltip :global(span) { color: var(--text-secondary); }
  .chart.active .tooltip { display: block; }
</style>
