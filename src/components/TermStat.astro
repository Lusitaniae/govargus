---
// One president × one indicator: what happened during the term next to what
// was already happening in the four years before it.
import { type Indicator, type TermStat, formatValue, formatPeriod } from '../lib/data';

interface Props { ind: Indicator; stat: TermStat | null; part: 'during' | 'before' }
const { ind, stat, part } = Astro.props;
const perYear = (v: number) => `${formatValue(v, ind, { signed: true, decimals: ind.decimals === 0 ? 0 : 2 })}/yr`;
---
{!stat ? (
  <span class="muted">no data</span>
) : stat.kind === 'average' ? (
  part === 'during' ? (
    <span>avg <b>{formatValue(stat.mean!, ind)}</b>{stat.partial && <span class="muted"> so far</span>}</span>
  ) : stat.priorMean !== undefined ? (
    <span>avg {formatValue(stat.priorMean, ind)}</span>
  ) : <span class="muted">—</span>
) : part === 'during' ? (
  <span>
    {formatValue(stat.start![1], ind)} → <b>{formatValue(stat.end![1], ind)}</b>
    <br /><span class="muted small">{perYear(stat.perYear!)}{stat.partial && ` · through ${formatPeriod(stat.end![0], ind.frequency)}`}</span>
  </span>
) : stat.priorPerYear !== undefined ? (
  <span>{perYear(stat.priorPerYear)}</span>
) : <span class="muted">—</span>}
