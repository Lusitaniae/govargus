---
import Layout from '../layouts/Layout.astro';
import LineChart from '../components/LineChart.astro';
import { groups, indicators, seriesFor, chartFrom, formatValue, formatPeriod, presidentAt } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = presidentAt(new Date().toISOString().slice(0, 10));
---
<Layout>
  <h1>How is the United States doing?</h1>
  <p class="lede">
    Official indicators, since 1980 where the data goes back that far, drawn over every presidential term, with the laws,
    trade moves and shocks that hit along the way. Presidents get credit and blame for
    everything, but they share the controls with Congress, the Fed and the rest of the world, and most
    policies take years to show up. So nothing here is scored. Each president page compares
    their term with the trend they inherited, and the rest is up to you.
  </p>

  {groups.map((g) => (
    <section>
      <h2>{g.name}</h2>
      <div class="grid">
        {indicators.filter((i) => i.group === g.id).map((ind) => {
          const s = seriesFor(ind.id);
          const [date, value] = s.points.at(-1)!;
          return (
            <article class="card">
              <a class="card-head" href={`${base}/indicators/${ind.id}`}>
                <h3>{ind.name}</h3>
                <p><span class="value">{formatValue(value, ind)}</span> <span class="muted small">{formatPeriod(date, ind.frequency)}{s.provisionalFrom && ', provisional'}</span></p>
              </a>
              <LineChart indicator={ind} points={s.points} from={chartFrom(s.points)} size="card" provisionalFrom={s.provisionalFrom} />
            </article>
          );
        })}
      </div>
    </section>
  ))}

  {current && (
    <p class="small muted" style="margin-top:32px">
      Current term: <a href={`${base}/presidents/${current.slug}`}>{current.name}</a>, since {current.start.slice(0, 4)}.
    </p>
  )}
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
  @media (max-width: 400px) { .grid { grid-template-columns: 1fr; } }
  .card-head { display: block; color: inherit; text-decoration: none; margin-bottom: 4px; }
  .card-head:hover h3 { color: var(--link); text-decoration: underline; }
  .card-head p { margin: 2px 0 0; }
  .value { font-size: 22px; font-weight: 600; }
</style>
