---
// One indicator year by year ("gas prices by year"). Every presidential term
// side by side is the compare page ("gas prices by president"); the two link
// to each other but answer different searches.
import Layout from '../../layouts/Layout.astro';
import LineChart from '../../components/LineChart.astro';
import {
  type President, indicators, groups, events, seriesFor, chartFrom,
  formatValue, formatPeriod, formatDate, KIND_LABEL,
} from '../../lib/data';
import { indicatorTitle, indicatorDescription, dataset, breadcrumbs, keywordCap, tableYears } from '../../lib/seo';
import { extremes, termRange, currentTerm } from '../../lib/summary';
import { yearlyRows, endLabel } from '../../lib/yearly';
import { hasTermPage, termPath } from '../../lib/term';

export function getStaticPaths() {
  return indicators.map((ind) => ({ params: { id: ind.id } }));
}

const ind = indicators.find((i) => i.id === Astro.params.id)!;
const group = groups.find((g) => g.id === ind.group)!;
const series = seriesFor(ind.id);
const [lastDate, lastValue] = series.points.at(-1)!;
const relevant = events.filter((e) => e.indicators.includes(ind.id) && e.date >= chartFrom(series.points));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [, , unit] = ind.name.match(/^(.*?)(?:\s*(\(.*\)))?$/)!;
const facts = [extremes(ind, series), currentTerm(ind, series)].filter(Boolean);
const byPresident = termRange(ind, series);
const related = indicators.filter((i) => i.group === ind.group && i.id !== ind.id);

const rows = yearlyRows(ind, series);
const sub = ind.frequency !== 'annual';
const change = ind.summary === 'change';
const per = ind.frequency === 'monthly' ? 'monthly' : 'quarterly';
const tableNote = [
  sub ? `Average of each year's ${per} readings, and the ${endLabel(ind)} reading` : 'One value per year',
  change ? `, with the change from the year before.` : '.',
  /fiscal year/i.test(ind.description) ? ' Years are federal fiscal years (October to September).' : '',
  ' The president is whoever held office for most of the year.',
].join('');
const presidentLink = (p: President) => `${base}${hasTermPage(p, ind) ? termPath(p, ind) : `/presidents/${p.slug}`}`;
const pct = (v?: number) => (v === undefined ? '' : `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}%`);
---
<Layout
  title={indicatorTitle(ind, series)}
  description={indicatorDescription(ind, series)}
  image={`/og/${ind.id}.png`}
  markdown={`/indicators/${ind.id}.md`}
  schema={[dataset(ind, series), breadcrumbs([['Indicators', '/'], [ind.name, `/indicators/${ind.id}`]])]}
>
  <p class="small muted">{group.name}</p>
  <h1>US {ind.keyword} by year{unit && <span class="unit"> {unit}</span>}</h1>
  <p class="lede">{ind.description}</p>
  <p><span class="value">{formatValue(lastValue, ind)}</span> <span class="muted">latest, {formatPeriod(lastDate, ind.frequency)}{series.provisionalFrom && ' (provisional)'}</span></p>

  <div class="panel">
    <LineChart indicator={ind} points={series.points} from={chartFrom(series.points)} provisionalFrom={series.provisionalFrom} />
  </div>
  <p class="small muted">
    Source: {ind.source.publisher}, via <a href={ind.source.page}>{ind.source.label}</a>.{' '}
    {ind.frequency[0].toUpperCase() + ind.frequency.slice(1)} data, fetched {formatDate(series.fetched)}.
  </p>

  <p class="facts">{facts.join(' ')}</p>

  <h2>{keywordCap(ind)} by year, {tableYears(series)}</h2>
  <p class="lede small">{tableNote}</p>
  <div class="table-scroll">
    <table class="data">
      <thead>
        <tr>
          <th>Year</th>
          {sub && <th>Average</th>}
          <th>{endLabel(ind)}</th>
          {change && <th>Change</th>}
          <th>President</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>{r.label}{r.provisional && <span class="muted small"> provisional</span>}</td>
            {sub && <td>{formatValue(r.avg!, ind)}</td>}
            <td>{formatValue(r.end, ind)}</td>
            {change && (
              <td>
                {r.change === undefined ? '' : formatValue(r.change, ind, { signed: true })}
                {r.pct !== undefined && <span class="muted small"> {pct(r.pct)}</span>}
              </td>
            )}
            <td>{r.president ? <a href={presidentLink(r.president)}>{r.president.name}</a> : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>By president</h2>
  <p class="facts">
    {byPresident}{' '}
    <a href={`${base}/compare/${ind.id}`}>{keywordCap(ind)} by president</a>: {change ? 'where every term started and ended, the change,' : 'the average in every term'} and the trend each one inherited.
  </p>

  {related.length > 0 && (
    <>
      <h2>More {group.name.toLowerCase()} data by year</h2>
      <ul class="related">
        {related.map((i) => <li><a href={`${base}/indicators/${i.id}`}>US {i.keyword} by year</a></li>)}
      </ul>
    </>
  )}

  {relevant.length > 0 && (
    <>
      <h2>Events that bear on this indicator</h2>
      <ol class="events">
        {relevant.slice().reverse().map((e) => (
          <li>
            <span class="muted small">{formatDate(e.date)}</span> <span class="tag">{KIND_LABEL[e.kind]}</span>
            <div><a href={e.link}>{e.title}</a>. {e.summary}</div>
          </li>
        ))}
      </ol>
    </>
  )}
</Layout>

<style>
  .value { font-size: 28px; font-weight: 600; }
  h1 .unit { font-weight: 400; color: var(--text-secondary); font-size: 0.7em; }
  .facts { max-width: 68ch; }
  .related { padding-left: 20px; }
  .related li { margin: 4px 0; }
  .events { list-style: none; padding: 0; margin: 0; }
  .events li { padding: 10px 0; border-bottom: 1px solid var(--grid); }
  table.data td:last-child, table.data th:last-child { text-align: left; white-space: nowrap; }
</style>
