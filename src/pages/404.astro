---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Not found">
  <h1>Page not found</h1>
  <p class="lede">That page doesn't exist. Try the <a href={`${base}/`}>indicators</a>, the <a href={`${base}/presidents`}>presidents</a> or the <a href={`${base}/compare`}>comparison</a>.</p>
</Layout>
